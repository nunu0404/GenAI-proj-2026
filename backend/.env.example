# NextSlide 설정 예시. 이 파일을 backend/.env 로 복사해 값을 채우세요.
# API 키는 서버 환경변수로만 읽습니다. 브라우저로 전달되거나 로그에 기록되지 않습니다.

# ---------------------------------------------------------------- 제공자 선택
# mock: 자격증명 없이 실행 (화면에 MOCK 표시, 실제 API 결과 아님)
# 실제 실행 권장 구성(임시): STT_PROVIDER=gemini, TEXT_PROVIDER=openai, IMAGE_PROVIDER=openai
STT_PROVIDER=mock          # gemini | openai | mock
TEXT_PROVIDER=mock         # openai | anthropic | mock
IMAGE_PROVIDER=mock        # openai | mock

# ---------------------------------------------------------------- 자격증명
# TEXT_PROVIDER=openai, IMAGE_PROVIDER=openai, STT_PROVIDER=openai 일 때 필요
OPENAI_API_KEY=
# STT_PROVIDER=gemini 일 때 필요 (Google AI Studio 에서 발급).
# ⚠ Cloud Billing 이 꺼진 프로젝트의 키는 '무료 등급' → 가격표상 입력 콘텐츠(강의 음성)가 Google 제품 개선에 사용됨.
#   유료 등급(결제 활성화)은 사용되지 않음. Google AI Pro 의 월간 Cloud 크레딧도 Cloud Billing 활성화가 전제.
GEMINI_API_KEY=
# TEXT_PROVIDER=anthropic 일 때만 필요 (선택 사항)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- 음성 인식 (Gemini Live transcription) — 임시 기본
# 문서 확인(2026-11-05): BidiGenerateContent WebSocket, audio/pcm;rate=16000 (mono PCM16), 수동 활동 감지
# (activityStart/activityEnd), setupComplete 수신 후 ready, 세션 최대 10분 → GEMINI_STT_ROTATE_S 전에 쉬는 구간에서 교체.
# 브라우저는 서버 설정에 맞춰 16kHz 로 리샘플링한다(OpenAI 는 24kHz).
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_STT_LANGUAGES=ko-KR
GEMINI_STT_MODE=VERBATIM          # VERBATIM(기본, 보내지 않음) | SMART
GEMINI_STT_VOCABULARY=            # 쉼표 구분 전문용어 (customVocabulary — 요소 형식 실제 API 미검증, 비워 두면 보내지 않음)
GEMINI_STT_ROTATE_S=480

# ---------------------------------------------------------------- 음성 인식 (OpenAI Realtime transcription) — 선택
# 문서 확인(2026-11-05): wss://api.openai.com/v1/realtime?intent=transcription, audio/pcm 24kHz mono PCM16,
# gpt-live-transcribe 는 turn_detection=null (서버 VAD 미지원) → 이 앱의 서버 VAD 가 구간 끝에서 commit.
OPENAI_STT_MODEL=gpt-live-transcribe
STT_LANGUAGES=ko
STT_DELAY=low              # minimal | low | medium | high | xhigh (낮을수록 임시 결과가 빠름)
STT_MAX_RECONNECTS=3
# 서버 VAD (20ms 프레임 RMS, int16 기준). 마이크/방 소음에 맞춰 조정.
VAD_RMS_THRESHOLD=450
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_MAX_SEGMENT_MS=12000
VAD_PREROLL_MS=300
# VAD_MIN_SPEECH_MS 미만의 유성 구간은 STT 로 보내지도 commit 하지도 않음(잡음 제거).
# 전사 완료 순서는 보장되지 않으므로(문서) commit 순서대로 보정해 감지기에 전달:
STT_REORDER_TIMEOUT_MS=3000     # 뒤 구간이 이미 왔는데 앞 구간이 이 시간 넘게 안 오면 건너뜀
STT_RESULT_TIMEOUT_MS=10000     # 어떤 결과도 이 시간 넘게 안 오면 건너뜀
STT_SESSION_ACK_TIMEOUT_S=10    # session.update 후 session.updated(설정 승인) 대기 시간. 초과 시 실패 처리
# 승인 응답에서 session.type / 전사 모델 / audio/pcm / 24000 을 확인. 항목이 없으면 true=실패(검증 불가), false=경고 후 진행
STT_STRICT_SESSION_CHECK=true

# ---------------------------------------------------------------- 슬라이드 기획 (OpenAI) — 임시 기본
# gpt-6-luna: 모델 페이지 "focused, high-volume tasks" 용, $0.10/$0.50 per 1M tok, 구조화 출력·reasoning effort none 지원
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TEXT_REASONING=none        # none | minimal | low | medium ... (낮을수록 빠르고 저렴)

# ---------------------------------------------------------------- 슬라이드 기획 (Claude) — 선택 (Team 크레딧은 Owner 만 수령 가능)
# ⚠ 임시 기본값. 실시간·저비용 우선으로 Haiku 5.5 를 쓰고, 실측(eval/latency_probe.py) 후 확정한다.
#   비교 후보: claude-haiku-5-5 ($0.10/$0.50 per 1M tok) · claude-sonnet-5-5 ($2/$10) · claude-opus-5-5 ($4/$20)
ANTHROPIC_TEXT_MODEL=claude-haiku-5-5
TEXT_EFFORT=low            # low | medium | high (낮을수록 빠르고 저렴)
TEXT_THINKING=             # 비우면 생략(모델 기본 adaptive). disabled 는 Haiku 5.5·Opus 5 에서 effort≤high 일 때만 전송
TEXT_MAX_TOKENS=4000
TEXT_TIMEOUT_S=60
TEXT_MAX_REPAIR=1          # 구조화 출력 검증 실패 시 재요청 최대 횟수
TEXT_USE_FALLBACKS=true    # 거절 시 서버 측 fallbacks:"default". 지원 모델(Opus 5.5/Sonnet 5.5/Fable)에서만 전송, Haiku 는 자동 생략

# ---------------------------------------------------------------- 설명 이미지 (OpenAI Images)
OPENAI_IMAGE_MODEL=gpt-image-2
# 사용자 지정 크기: 두 변 16의 배수, 비율 1:3~3:1, 총 픽셀 655,360~8,294,400 (문서 확인 2026-11-05)
IMAGE_SIZE=1536x864
IMAGE_QUALITY=low          # ⚠ 임시값. low | medium | high — 문서: low 는 빠른 초안용. 실측 후 medium 과 비교해 확정
IMAGE_FORMAT=jpeg          # jpeg 가 png 보다 빠름(문서). png | jpeg | webp
IMAGE_TIMEOUT_S=150
IMAGE_MAX_RETRIES=1        # 시간 초과·5xx·429 일 때만 재시도

# ---------------------------------------------------------------- 요청 감지 / 맥락 / 대기열
REQUEST_SILENCE_MS=2500    # 완료 표현이 없을 때 이 시간 침묵하면 요청 판단
CONTEXT_WINDOW_S=90        # 요청 직전 몇 초의 확정 발화를 맥락으로 쓸지
CONTEXT_MAX_CHARS=1500     # 맥락 상한 (최근 쪽을 남기고 자름)
MAX_QUEUE=3                # 실행 중 1개 + 대기 최대 3개

# ---------------------------------------------------------------- 비용 추정용 단가 (USD)
# 비어 있으면 비용을 추정하지 않습니다. 추정치는 실제 청구액이 아닙니다.
# 아래 값은 기본 모델 기준으로 2026-11-05 에 공식 가격표에서 확인한 값입니다. 모델을 바꾸면 반드시 갱신하세요.
#   gpt-6-luna: 입력 $0.10 / 출력 $0.50 per 1M tokens (OpenAI 모델 페이지) — Claude Haiku 5.5 도 같은 값
#   gpt-image-2: 텍스트 입력 $5 / 이미지 출력 $30 per 1M tokens (OpenAI 가격표)
#   gemini-3.5-transcribe-live 유료: 오디오 입력 $0.005/분 + 텍스트 출력 $0.004/분, 문서 각주의 혼합 추정 ~$0.009/분
#     (무료 등급이면 $0). OpenAI gpt-live-transcribe 로 바꾸면 0.017
PRICE_TEXT_INPUT_PER_MTOK=0.10
PRICE_TEXT_OUTPUT_PER_MTOK=0.50
PRICE_IMAGE_TEXT_INPUT_PER_MTOK=5
PRICE_IMAGE_OUTPUT_PER_MTOK=30
PRICE_STT_PER_MIN=0.009

# ---------------------------------------------------------------- 기타
# DATA_DIR=./data           # SQLite 와 이미지 저장 위치 (기본 backend/data)
MOCK_TEXT_DELAY_MS=900
MOCK_IMAGE_DELAY_MS=2500
